{
  "name": "hookky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI motion-graphics studio for product ads and launches",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs",
    "test": "tsx --test server/*.test.ts src/*.test.ts",
    "test:engine": "node scripts/smoke.mjs",
    "build:site": "vite build --config vite.site.config.ts",
    "dev:site": "vite --config vite.site.config.ts --port 5174"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@iconify-json/iconoir": "^1.2.12",
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.43",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "playwright": "^1.63.0",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
