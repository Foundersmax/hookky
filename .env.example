# --- Agent brain (Claude). Any of these works; without one the built-in local director is used.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_WEB_SEARCH=on        # set "off" if web search is disabled for your org

# --- Visual connectors (all optional; Openverse + URL import work with no key)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=               # free: photos + stock video (pexels.com/api)
PIXABAY_API_KEY=              # free: photos + stock video (pixabay.com/api/docs)
COVERR_API_KEY=               # free: stock video (coverr.co/developers)
FREEPIK_API_KEY=              # Freepik stock search + Magnific upscaler
ENVATO_TOKEN=                 # Envato Market personal token
PINTEREST_ACCESS_TOKEN=       # Pinterest API v5 user token (searches your pins/boards)

# --- Voice-over transcription for word-level sync (optional; otherwise paste the script)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=               # used only for Whisper speech-to-text

# --- Accounts (sign-up, email confirmation, admin approval). Needs Postgres.
DATABASE_URL=                 # e.g. postgres://user:pass@host:5432/hookky
ADMIN_EMAILS=                 # comma-separated; these become admins when they confirm their email
BREVO_API_KEY=                # transactional email; without it emails are printed to the server log
MAIL_FROM=                    # a sender verified in Brevo, e.g. hello@rookker.com
MAIL_FROM_NAME=Rookker
APP_URL=                      # public address used in email links, e.g. https://app.rookker.com
SITE_URL=                     # landing page with sign-in/sign-up, e.g. https://rookker.com (email links land there)
AGENT_DAILY_LIMIT=100         # agent turns per user per day (admins are unlimited)

# --- Without accounts: password-protect a public deploy (browser prompt, any username)
HOOKKY_PASSWORD=

PORT=8787
